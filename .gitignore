# ---------------------------------------------------------------------------
# Secrets and credentials — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env.local
secrets.json
**/serviceAccount*.json
**/*credentials*.json
*.pem
*.key
*.p8
*.p12
*.cer
*.mobileprovision

# Firebase app config: regenerate per-developer from the Firebase console
# (`firebase apps:sdkconfig`). Not a hard secret, but it ties the repo to a
# specific project and leaks the sender/app ids, so keep it out of the remote.
google-services.json
GoogleService-Info.plist
.firebase/
firebase-debug*.log
.firebaserc

# Signing keys. debug.keystore is the shared Android debug key and is safe to
# commit; a release keystore never is.
*.keystore
*.jks
!debug.keystore
android/keystores/
release.keystore

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Node / JavaScript
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log
*.log
.npm/
.eslintcache
.node_repl_history

# Yarn (berry)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# ---------------------------------------------------------------------------
# React Native / Metro
# ---------------------------------------------------------------------------
.metro-health-check*
metro-cache/
.expo/
.expo-shared/
*.jsbundle
*.bundle.map
.watchmanconfig.local

# Tests / coverage
/coverage
coverage/
jest-cache/
.jest-cache/
*.lcov

# Build output
dist/
tmp/
temp/
.cache/

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
build/
.gradle/
local.properties
captures/
.externalNativeBuild/
.cxx/
.kotlin/
*.hprof
*.apk
*.aab
*.ap_
*.dex
android/app/src/main/assets/index.android.bundle*
android/app/release/
android/.settings/
android/gradle.properties.local

# ---------------------------------------------------------------------------
# iOS / Xcode
# ---------------------------------------------------------------------------
ios/build/
DerivedData/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.xcscmblueprint
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xcuserstate
**/.xcode.env.local
ios/.xcode.env.local
ios/main.jsbundle

# CocoaPods — the Pods dir is regenerated by `pod install`
**/Pods/
ios/Podfile.lock.orig

# Ruby / Bundler
/vendor/bundle/
.bundle/vendor/

# fastlane (regenerate reports and screenshots; never commit them)
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output
**/fastlane/*.mobileprovision
